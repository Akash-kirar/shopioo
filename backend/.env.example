# Server-only configuration. Never prefix these values with VITE_.
NODE_ENV=development
PORT=3000

# Gemini key: keep this only in backend/.env.local or your deployment secret store.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin: prefer GOOGLE_APPLICATION_CREDENTIALS to a key file stored
# outside this repository, or use a platform workload identity in production.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional alternative when your host provides the JSON as a secret variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# PostgreSQL. DATABASE_URL is for runtime; DATABASE_ADMIN_URL is for migrations.
DATABASE_URL=
DATABASE_ADMIN_URL=
